{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts",
    "../src/data/products.ts",
    "../src/lib/types.ts"
  ]
}